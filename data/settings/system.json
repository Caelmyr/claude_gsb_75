{
  "site_name": "在线代码评测与竞赛系统",
  "judge": {
    "max_concurrent": 4,
    "sandbox": "auto",
    "default_time_limit_ms": 1000,
    "default_memory_limit_kb": 65536,
    "compile_timeout_ms": 15000,
    "run_timeout_multiplier": 3,
    "output_limit_kb": 4096,
    "sync_recent_cache": true,
    "redact_code": true
  },
  "anti_cheat": {
    "enabled": true,
    "similarity_threshold": 0.9,
    "window_seconds": 60
  },
  "ranking": {
    "penalty_seconds": 20
  },
  "registration": {
    "allow": true
  }
}